<view class="page"><view class="title">告警中心</view><view class="error" wx:if="{{error}}">{{error}}</view><view class="empty" wx:if="{{!items.length}}">暂无告警</view><view class="item" wx:for="{{items}}" wx:key="id"><view class="name">{{item.title}}</view><view>{{item.message}}</view><view class="muted">{{item.suggestion}}</view><button class="button secondary" wx:if="{{!item.is_read}}" data-id="{{item.id}}" bindtap="read">标为已读</button><text class="muted" wx:else>已读</text></view></view>
