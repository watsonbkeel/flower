<view class="page"><view class="title">{{plant.name}} · 养护卡</view><view class="error" wx:if="{{error}}">{{error}}</view>
<view class="section"><view class="name">植物识别</view><button class="button secondary" bindtap="capture" disabled="{{busy}}">重新拍照</button>
<view class="notice" wx:if="{{retakeRecommended}}">识别置信度较低，建议重新拍照或手动填写植物名称。</view>
<radio-group bindchange="choose"><label class="item row" wx:for="{{candidates}}" wx:key="scientific_name"><view><view>{{item.common_name}}</view><view class="muted">{{item.scientific_name}} · {{item.confidence}}</view></view><radio value="{{index}}" checked="{{selected === index}}" color="#246b4b"/></label></radio-group>
<view class="field"><text class="label">手动名称</text><input value="{{commonName}}" data-field="commonName" bindinput="field"/></view><view class="field"><text class="label">学名</text><input value="{{scientificName}}" data-field="scientificName" bindinput="field"/></view>
<button class="button" bindtap="confirmSpecies" disabled="{{busy}}">确认品种</button></view>
<view class="section"><view class="name">养护研究</view><view class="muted">{{plant.city}} · {{plant.timezone}}</view><view class="notice" wx:if="{{jobText}}">{{jobText}}</view><button class="button secondary" bindtap="generate" disabled="{{busy || !plant.recognition_confirmed}}">生成养护卡</button></view>
<view class="section" wx:if="{{profile}}"><view class="row"><view class="name">AI养护卡</view><text class="source">{{profile.profile.source_type === 'real' ? '真实来源' : '模拟知识'}}</text></view><view class="metric">{{profile.profile.soil_target_min_pct}}–{{profile.profile.soil_target_max_pct}}%</view><view class="muted">相对土壤湿度目标区间</view><view class="error" wx:if="{{profile.needs_review}}">资料存在冲突或需要复核</view>
<view class="item"><view class="name">园艺资料</view><view class="item" wx:for="{{profile.profile.sources}}" wx:key="id" data-url="{{item.url}}" bindtap="copySource"><view>{{item.title}}</view><view class="muted">{{item.summary}}</view></view></view>
<view class="item"><view class="name">当地环境</view><view class="muted">{{weather.sourceLabel}} · {{weather.statusText}}</view><view wx:if="{{weather.available}}">{{weather.temperatureText}} °C · 未来12小时降雨 {{weather.rainText}} mm</view><view class="muted" wx:if="{{weather.observedText}}">观测时间：{{weather.observedText}}</view></view>
<button class="button" bindtap="confirmCare" disabled="{{busy || profile.confirmed}}">{{profile.confirmed ? '已确认养护卡' : '确认养护卡'}}</button></view></view>
