<view class="page"><view class="title">土壤趋势</view><view class="source">{{label}}</view><view class="error" wx:if="{{error}}">{{error}}</view><view class="pill-row"><button data-value="1d" bindtap="range">24小时</button><button data-value="7d" bindtap="range">7天</button><button data-value="30d" bindtap="range">30天</button></view><view class="row"><text>模拟数据</text><switch checked="{{source === 'mock'}}" bindchange="source" color="#246b4b"/></view><view class="section"><view class="muted">相对土壤湿度 · %</view><canvas id="trend" type="2d" class="chart"/><view class="empty" wx:if="{{!points.length}}">数据积累中</view></view><view class="name">补水记录</view><view class="item" wx:for="{{events}}" wx:key="id">{{item.occurred_at}} · {{item.actual_ml}} mL</view></view>
